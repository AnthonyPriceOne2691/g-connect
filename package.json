{
  "name": "g-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Универсальное ядро доступа агента к Google Docs/Sheets/Drive и локальным папкам",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "gc": "node --experimental-strip-types src/cli/manual.ts"
  },
  "dependencies": {
    "googleapis": "^178.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "jscpd": "^5.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
